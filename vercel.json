{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "cleanUrls": true,
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, must-revalidate"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/laundry",
            "destination": "/laundry.html"
        }
    ]
}